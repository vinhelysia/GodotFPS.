[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scripts/Raid/raid_return_error.gd" id="1"]
[ext_resource type="Theme" path="res://addons/cogito/Theme/Cogito_Theme_A.tres" id="2"]

[node name="RaidReturnError" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.04, 0.88)

[node name="Center" type="CenterContainer" parent="Backdrop"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Backdrop/Center"]
custom_minimum_size = Vector2(540, 0)
layout_mode = 2
theme = ExtResource("2")

[node name="Margin" type="MarginContainer" parent="Backdrop/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Backdrop/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Backdrop/Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Return to Hub failed"
horizontal_alignment = 1

[node name="Message" type="Label" parent="Backdrop/Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Your raid is over. Carried gear is lost; stash is preserved.\nRetry returning to Hub, or quit."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Backdrop/Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="RetryButton" type="Button" parent="Backdrop/Center/Panel/Margin/Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Retry Return"

[node name="QuitButton" type="Button" parent="Backdrop/Center/Panel/Margin/Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Quit"

[connection signal="pressed" from="Backdrop/Center/Panel/Margin/Content/Buttons/RetryButton" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Backdrop/Center/Panel/Margin/Content/Buttons/QuitButton" to="." method="_on_quit_pressed"]
